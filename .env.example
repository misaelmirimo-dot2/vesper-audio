# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Jamendo API v3.0 Credentials (Server-side only - NEVER expose to frontend)
# Register at https://devportal.jamendo.com/ to obtain a Client ID
JAMENDO_CLIENT_ID=""
JAMENDO_CLIENT_SECRET=""
JAMENDO_API_BASE_URL="https://api.jamendo.com/v3.0"

# YouTube Data API v3 (Optional server-side key for higher search quota)
YOUTUBE_API_KEY=""
